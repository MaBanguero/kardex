# =============================================================================
# KARDEX — Environment variables (copy to .env for local dev)
# =============================================================================
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=generate-a-long-secure-random-key-here
DJANGO_DEBUG=True

# En Coolify, set this to tu-dominio.com (separar múltiples con coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# En Coolify, set this a https://tu-dominio.com (con protocolo, separar con coma)
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL — Coolify los inyecta automáticamente via service link
POSTGRES_DB=kardex
POSTGRES_USER=kardex
POSTGRES_PASSWORD=kardex
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Workers de Gunicorn (opcional)
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
