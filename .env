# =============================================================================
# KARDEX — .env para desarrollo local
# Copia de .env.example, ajusta según necesites
# En Coolify estas variables se configuran desde la UI
# =============================================================================
DJANGO_SECRET_KEY=django-insecure-dev-only-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Para usar SQLite local, deja POSTGRES_HOST sin definir (comentado)
# POSTGRES_DB=kardex
# POSTGRES_USER=kardex
# POSTGRES_PASSWORD=kardex
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
